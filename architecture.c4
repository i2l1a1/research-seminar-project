specification {
  element actor { style { shape person } }
  element system { style { shape rectangle } }
  element container { style { shape rectangle opacity 10% border solid } }
  element component { style { shape component } }
  element queue { style { shape queue } }
  element storage { style { shape storage } }
  element document { style { shape document } }

  tag api
  tag business
  tag ml
  tag infra
  tag optional
  tag mvp
}

model {
  user = actor 'Пользователь' {
    description 'Отправляет запрос и получает ответ через REST API'
  }

  app = system 'LLM Chain REST API (FastAPI + LangChain)' {
    title 'LLM Chain REST API'
    description '''
      Цель: спроектировать и реализовать REST-интерфейс, который выполняет цепочку из 4 LLM-шагов:
      1) Классификация типа вопроса (technical, advice, tutorial, current, creative)
      2) Сбор фактов по вопросу
      3) Генерация черновика с опорой на эти факты
      4) Шлифовка и генерация финального ответа по фактам и черновику
      5) [дополнительный] Оценка качества ответа (LLM-as-a-judge)

      MVP:
      - последовательный вызов бесплатных моделей
      - REST: запрос -> ответ

      Не вошло в MVP:
      - более новые и дорогие модели
      - очередь сообщений
      - кэширование
      - долгосрочная память
      - RAG

      Узкие места:
      - вызовы LLM (latency, стоимость, лимиты, таймауты)
      - качество валидации и стабильность оценок LLM-as-a-judge
    '''
    technology 'Python • FastAPI • LangChain • OpenRouter.ai'

    restApi = container 'REST API (FastAPI)' {
      #api #mvp
      description '''
      Контейнер приложения.
      Отдельный сервис в `docker-compose`.

      Эндпоинты:
      - `POST /v1/generate` - основной пользовательский сценарий
      - `GET /health` - проверка работоспособности
      - `GET /metrics` - метрики Prometheus
      '''

      health = component 'GET /health' {
        description 'Проверка работоспособности сервиса'
      }

      generate = component 'POST /v1/generate' {
        description '''
        Основной сценарий: пользовательский запрос -> ответ.
        Обработка: передача в LangChain pipeline, возврат структурированного ответа,
        включая метаданные (latency по шагам, тип вопроса, оценки качества).
        '''
      }
    }

    pipeline = container 'LangChain Pipeline Orchestrator' {
      #business #ml #mvp
      description '''
      Оркестрация бизнес-логики и ML-цепочки из 4 этапов.
      Производительность: измеряем latency каждого этапа.
      Масштабируемость: синхронно (MVP), в будущем асинхронно через очередь.
    '''

      configUsage = component 'Input/Output + обработка ошибок' {
        #business
        description '''
        Предобработка (нормализация, лимиты длины, валидация).
        Обработка ошибок: таймауты, повторные попытки, fallback-ответы.
        '''
      }

      classify = component 'Шаг 1: Классификация вопроса' {
        #ml #mvp
        description '''
        Определяет тип вопроса: technical, advice, tutorial, current, creative.
        Использует отдельный LLM-вызов.
        '''
      }

      factGathering = component 'Шаг 2: Сбор фактов' {
        #ml #mvp
        description '''
        LLM собирает все известные ей факты, чтобы в будущих промптах опираться на эти факты.
        '''
      }

      draftGeneration = component 'Шаг 3: Генерация черновика' {
        #ml #mvp
        description '''
        LLM генерирует черновик ответа с опорой на факты. Тут могут быть погрешности в стиле и лишние фразы.
        '''
      }

      finalGeneration = component 'Шаг 4: Генерация финального ответа' {
        #ml #mvp
        description '''
        LLM финализирует ответ: добавляет/убирает детали, улучшает структуру и логику ответа.
        '''
      }

      judge = component 'Шаг 5: Оценка качества (LLM-as-a-judge)' {
        #ml #mvp
        description '''
        Отдельный LLM-вызов для оценки ответа по шести критериям:
        accuracy, relevance, completeness, conciseness, coherence, style.
        '''
      }

      routerAdapter = component 'OpenRouter Adapter (HTTP-клиент)' {
        #ml
        description 'Унифицированный доступ к LLM через OpenRouter'
      }
    }

    config = document 'Конфигурация моделей и параметров' {
      #business
      description '''
      ENV-переменные:
      OPENROUTER_API_KEY, OPENROUTER_BASE_URL,
      MODEL_STEP1..MODEL_STEP5, TIMEOUT_SEC, MAX_TOKENS, RETRIES, LOG_LEVEL.
      Модели можно заменить без правки кода.
      '''
    }

    observability = container 'Логирование и метрики' {
      #infra
      description '''
      Логирование ошибок, предупреждений, информационных сообщений.
      Метрики Prometheus: latency общая и по шагам, счётчики запросов,
      оценки качества (accuracy, relevance, completeness, conciseness, coherence, style).
      '''

      logs = component 'Логи' {
        description 'Формат JSON (или читаемый) для всех этапов и ошибок.'
      }

      promExporter = component 'Метрики' {
        description '''
        Собирает:
        - llm_chain_latency_seconds (гистограмма)
        - llm_chain_stage_latency_seconds (по этапам)
        - llm_answer_* (оценки качества ответа)
        - http_* (FastAPI)
        - стандартные метрики Python-процесса
        '''
      }
    }

    quality = container 'Quality Metrics & Evaluation' {
      #infra
      description '''
      Автоматическая оценка качества ответов с помощью LLM-as-a-judge.
      Датасет из 5-10 тестовых запросов для замера метрик.
      Отчёты по метрикам (средние баллы, интерпретация).
      '''

      dataset = component 'Evaluation датасет' {
        description 'Небольшой датасет вопросов для тестирования качества.'
      }

      judge = component 'LLM-as-a-judge scorer' {
        description 'Реализован как шаг 5 pipeline. Оценивает финальный ответ.'
      }

      reports = component 'Отчёты по метрикам' {
        description 'Таблицы со средними оценками (accuracy, relevance и др.) для презентации.'
      }
    }

    tests = container 'Тестирование' {
      #infra
      description '''
      Unit-тесты (test_api.py, test_chain.py).
      Интеграционные тесты с реальным LLM.
      Нагрузочный тест.
      '''

      unit = component 'Unit-тесты' {
        description 'Проверка обработки ошибок, валидации, форматов.'
      }
    }

    scaling = container 'Масштабируемость' {
      #infra #optional
      description '''
      Узкое место: вызовы LLM.
      Будущие улучшения:
      - асинхронность через очередь задач
      - кэширование результатов (Redis)
      '''

      jobsQueue = queue 'Очередь' {
        description 'Очередь для выполнения цепочки как фоновой задачи.'
      }

      redisCache = storage 'Redis' {
        description 'Кэширование ответов для снижения стоимости и latency.'
      }
    }

  }

  openrouter = system 'OpenRouter' {
    #infra
    description '''
    Внешний сервис провайдера LLM.
    Используются бесплатные модели (gemma-4-31b-it:free) для всех шагов.
    '''
    openrouterApi = container 'OpenRouter API' {
      description 'HTTPS endpoint: выбор модели, стоимость, ответы.'
    }
  }

  legend = document 'Легенда' {
    description '''
    Элементы:
    - `actor`: пользователь
    - `container`: сервис/контейнер приложения
    - `component`: модуль/подсистема внутри контейнера
    - `queue`: очередь фоновых задач
    - `storage`: хранилище/кэш

    Теги:
    - `#mvp`: часть MVP
    - `#optional`: будущие улучшения
    '''
  }

  user -> app.restApi.generate 'POST /v1/generate'
  user -> app.restApi.health 'GET /health'

  app.config -> app.pipeline.routerAdapter 'model selection + params'

  app.restApi.generate -> app.pipeline.configUsage 'pre/post + error handling'
  app.pipeline.configUsage -> app.observability.logs 'log errors + traces'
  app.pipeline.configUsage -> app.observability.promExporter 'latency/cost metrics'

  app.restApi.generate -> app.pipeline.classify 'step1'
  app.pipeline.classify -> app.pipeline.factGathering 'step2'
  app.pipeline.factGathering -> app.pipeline.draftGeneration 'step3'
  app.pipeline.draftGeneration -> app.pipeline.finalGeneration 'step4'
  app.pipeline.finalGeneration -> app.pipeline.judge 'step5 (LLM-as-a-judge)'

  app.pipeline.classify -> app.pipeline.routerAdapter 'classify model'
  app.pipeline.factGathering -> app.pipeline.routerAdapter 'fact gathering model'
  app.pipeline.draftGeneration -> app.pipeline.routerAdapter 'draft generation model'
  app.pipeline.finalGeneration -> app.pipeline.routerAdapter 'final generation model'
  app.pipeline.judge -> app.pipeline.routerAdapter 'judge model (step5)'
  app.pipeline.routerAdapter -> openrouter.openrouterApi 'HTTPS'

  app.quality.dataset -> app.quality.judge 'eval criteria'
  app.quality.judge -> app.quality.reports 'quality scores + latency'

  app.tests.unit -> app.pipeline.configUsage 'unit tests'

  app.restApi.generate -> app.scaling.jobsQueue 'enqueue async (future)'
  app.scaling.jobsQueue -> app.pipeline.configUsage 'execute in background'
  app.pipeline.factGathering -> app.scaling.redisCache 'cache (future)'
}

views {
  view index {
    title 'C4 - Containers & Components (FastAPI + LangChain + OpenRouter)'
    description '''
    Актуальная архитектура проекта. Отражены 5 этапов LLM-цепочки:
    1. Классификация вопроса
    2. Сбор фактов
    3. Генерация черновика
    4. Генерация финального ответа
    5. Оценка качества (LLM-as-a-judge)

    Все этапы используют OpenRouter с бесплатными моделями.
    Собираются метрики производительности и качества.
    '''
    include *
  }
}